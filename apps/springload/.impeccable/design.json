    {
      "name": "主操作按钮 Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "套红实底的主操作，一个区域里只放一个。",
      "html": "<button class=\"ds-btn-primary\">开始筛选</button>",
      "css": ".ds-btn-primary{display:inline-flex;flex-shrink:0;align-items:center;justify-content:center;gap:6px;height:34px;padding:0 14px;border:1px solid var(--color-proof,#b8232a);border-radius:0;background:var(--color-proof,#b8232a);color:var(--color-paper,#e4e3de);font-family:var(--font-paper,-apple-system,BlinkMacSystemFont,\"PingFang SC\",sans-serif);font-size:var(--text-body,13px);line-height:var(--text-body--line-height,1.6);font-weight:500;cursor:pointer;transition:background-color .1s,border-color .1s,color .1s}.ds-btn-primary:hover{background:var(--color-ink,#16161a);border-color:var(--color-ink,#16161a);color:var(--color-paper,#e4e3de)}.ds-btn-primary:active{transform:translateY(1px)}.ds-btn-primary:focus-visible{outline:2px solid var(--color-proof,#b8232a);outline-offset:2px}.ds-btn-primary:disabled{opacity:.4;pointer-events:none}"
    },
    {
      "name": "次要按钮 Secondary Button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "浅纸灰底的并列操作，例如导出、同步、刷新。",
      "html": "<button class=\"ds-btn-secondary\">导出 PNG</button>",
      "css": ".ds-btn-secondary{display:inline-flex;flex-shrink:0;align-items:center;justify-content:center;gap:6px;height:34px;padding:0 14px;border:1px solid var(--color-ink,#16161a);border-radius:0;background:var(--color-slip,#efeee9);color:var(--color-ink,#16161a);font-family:var(--font-paper,-apple-system,BlinkMacSystemFont,\"PingFang SC\",sans-serif);font-size:var(--text-body,13px);line-height:var(--text-body--line-height,1.6);font-weight:500;cursor:pointer;transition:background-color .1s,border-color .1s,color .1s}.ds-btn-secondary:hover{background:var(--color-ink,#16161a);color:var(--color-paper,#e4e3de)}.ds-btn-secondary:active{transform:translateY(1px)}.ds-btn-secondary:focus-visible{outline:2px solid var(--color-proof,#b8232a);outline-offset:2px}"
    },
    {
      "name": "描边按钮 Outline Button",
      "kind": "button",
      "refersTo": "button-outline",
      "description": "透明底的描边按钮，工具条上未选中的工具与周期。",
      "html": "<button class=\"ds-btn-outline\" aria-pressed=\"false\">支撑区</button>",
      "css": ".ds-btn-outline{display:inline-flex;flex-shrink:0;align-items:center;justify-content:center;gap:6px;height:28px;padding:0 10px;border:1px solid var(--color-ink,#16161a);border-radius:0;background:transparent;color:var(--color-ink,#16161a);font-family:var(--font-paper,-apple-system,BlinkMacSystemFont,\"PingFang SC\",sans-serif);font-size:var(--text-note,12px);line-height:var(--text-note--line-height,1.5);font-weight:500;cursor:pointer;transition:background-color .1s,border-color .1s,color .1s}.ds-btn-outline:hover{background:var(--color-ink,#16161a);color:var(--color-paper,#e4e3de)}.ds-btn-outline:active{transform:translateY(1px)}.ds-btn-outline:focus-visible{outline:2px solid var(--color-proof,#b8232a);outline-offset:2px}"
    },
    {
      "name": "弱操作按钮 Ghost Button",
      "kind": "button",
      "refersTo": "button-ghost",
      "description": "无底无边的弱操作，例如删除、退出标注、放弃。",
      "html": "<button class=\"ds-btn-ghost\">删除</button>",
      "css": ".ds-btn-ghost{display:inline-flex;flex-shrink:0;align-items:center;justify-content:center;gap:6px;height:34px;padding:0 14px;border:1px solid transparent;border-radius:0;background:transparent;color:var(--color-ink-soft,#56544c);font-family:var(--font-paper,-apple-system,BlinkMacSystemFont,\"PingFang SC\",sans-serif);font-size:var(--text-body,13px);line-height:var(--text-body--line-height,1.6);font-weight:500;cursor:pointer;transition:background-color .1s,border-color .1s,color .1s}.ds-btn-ghost:hover{color:var(--color-ink,#16161a);text-decoration:underline;text-decoration-style:dotted;text-underline-offset:4px}.ds-btn-ghost:focus-visible{outline:2px solid var(--color-proof,#b8232a);outline-offset:2px}"
    },
    {
      "name": "输入框 Text Input",
      "kind": "input",
      "refersTo": "input",
      "description": "待填的一栏：方角、1px 控件边界灰、浅纸灰底。",
      "html": "<label class=\"ds-field\"><span class=\"ds-field-label\">买入价（元/股）</span><input class=\"ds-input\" value=\"20.00\" /></label>",
      "css": ".ds-field{display:flex;min-width:0;flex-direction:column;gap:4px}.ds-field-label{font-family:var(--font-paper,-apple-system,BlinkMacSystemFont,\"PingFang SC\",sans-serif);font-size:var(--text-note,12px);font-weight:500;color:var(--color-ink-soft,#56544c)}.ds-input{height:34px;width:100%;padding:0 10px;border:1px solid var(--color-rule-strong,#84806f);border-radius:0;background:var(--color-slip,#efeee9);color:var(--color-ink,#16161a);font-family:var(--font-paper,-apple-system,BlinkMacSystemFont,\"PingFang SC\",sans-serif);font-size:var(--text-body,13px);font-variant-numeric:tabular-nums;transition:border-color .1s}.ds-input::placeholder{color:var(--color-ink-soft,#56544c)}.ds-input:focus{border-color:var(--color-proof,#b8232a);outline:none}.ds-input:focus-visible{outline:2px solid var(--color-proof,#b8232a);outline-offset:2px}.ds-input:disabled{cursor:not-allowed;opacity:.5}"
    },
    {
      "name": "戳记 Stamp（告警档）",
      "kind": "chip",
      "refersTo": "stamp-danger",
      "description": "加了框的状态小签；告警档是实底反白，用于止损这类需要立刻处理的状态。",
      "html": "<span class=\"ds-stamp-danger\">止损</span>",
      "css": ".ds-stamp-danger{display:inline-flex;flex-shrink:0;align-items:center;justify-content:center;gap:4px;height:20px;padding:0 6px;border:1px solid var(--color-alert,#b8232a);border-radius:0;background:var(--color-alert,#b8232a);color:var(--color-paper,#e4e3de);font-family:var(--font-paper,-apple-system,BlinkMacSystemFont,\"PingFang SC\",sans-serif);font-size:var(--text-micro,11px);line-height:var(--text-micro--line-height,1.45);font-weight:500;white-space:nowrap}"
    },
    {
      "name": "稿件框 Panel",
      "kind": "card",
      "refersTo": "panel",
      "description": "版面上一则加了框的稿件：1px 栏线外框，题头下面一条 2px 油墨线，宋体标题在左、动作在右。",
      "html": "<section class=\"ds-panel\"><header class=\"ds-panel-head\"><h2 class=\"ds-panel-title\">交易计划卡</h2><div class=\"ds-panel-action\"><span class=\"ds-stamp-neutral\">草稿</span></div></header><div class=\"ds-panel-body\"><p>计划风险是理论值，滑点会让实际亏损超过预设的账户风险。</p></div></section>",
      "css": ".ds-panel{display:flex;min-width:0;flex-direction:column;border:1px solid var(--color-rule,#a09c8c);border-radius:0;background:var(--color-paper,#e4e3de);color:var(--color-ink,#16161a)}.ds-panel-head{display:flex;flex:none;flex-wrap:wrap;align-items:baseline;column-gap:12px;row-gap:4px;border-bottom:2px solid var(--color-ink,#16161a);padding:10px 14px}.ds-panel-title{margin:0;font-family:var(--font-display,\"Songti SC\",\"SimSun\",serif);font-size:var(--text-head,16px);line-height:var(--text-head--line-height,1.35);font-weight:700;color:var(--color-ink,#16161a)}.ds-panel-action{margin-left:auto;display:flex;flex-wrap:wrap;align-items:center;gap:8px}.ds-panel-body{display:flex;flex-direction:column;gap:14px;padding:14px;font-family:var(--font-paper,-apple-system,BlinkMacSystemFont,\"PingFang SC\",sans-serif);font-size:var(--text-body,13px);line-height:var(--text-body--line-height,1.6)}.ds-stamp-neutral{display:inline-flex;flex-shrink:0;align-items:center;justify-content:center;gap:4px;height:20px;padding:0 6px;border:1px solid var(--color-rule,#a09c8c);border-radius:0;background:var(--color-slip,#efeee9);color:var(--color-ink-soft,#56544c);font-family:var(--font-paper,-apple-system,BlinkMacSystemFont,\"PingFang SC\",sans-serif);font-size:var(--text-micro,11px);line-height:var(--text-micro--line-height,1.45);font-weight:500;white-space:nowrap}"
    },
    {
      "name": "稿件目录格 Step Chip（当前版次）",
      "kind": "nav",
      "refersTo": "step-chip-active",
      "description": "主流程顶部四个版次格之一：当前格压 2px 套红上边线、底色下凹一档、版次号与标题套红。",
      "html": "<button class=\"ds-step-chip ds-step-chip-active\" role=\"tab\" aria-selected=\"true\"><span class=\"ds-step-chip-line\"><span class=\"ds-step-chip-index\">3</span><span class=\"ds-step-chip-title\">等买入信号</span></span><span class=\"ds-step-chip-status\">等待中</span></button>",
      "css": ".ds-step-chip{display:flex;min-width:0;flex:1 1 0;flex-direction:column;gap:2px;padding:8px 12px;border:0;border-top:2px solid transparent;border-radius:0;background:var(--color-paper,#e4e3de);color:var(--color-ink,#16161a);text-align:left;font-family:var(--font-paper,-apple-system,BlinkMacSystemFont,\"PingFang SC\",sans-serif);cursor:pointer;transition:background-color .1s}.ds-step-chip-line{display:flex;align-items:baseline;gap:6px}.ds-step-chip-index{font-family:var(--font-display,\"Songti SC\",\"SimSun\",serif);font-size:var(--text-head,16px);font-weight:700;font-variant-numeric:tabular-nums}.ds-step-chip-title{font-family:var(--font-display,\"Songti SC\",\"SimSun\",serif);font-size:var(--text-body,13px);font-weight:700}.ds-step-chip-status{overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:var(--text-micro,11px);color:var(--color-ink-soft,#56544c)}.ds-step-chip-active{border-top-color:var(--color-proof,#b8232a);background:var(--color-slip,#efeee9)}.ds-step-chip-active .ds-step-chip-index,.ds-step-chip-active .ds-step-chip-title{color:var(--color-proof,#b8232a)}.ds-step-chip:focus-visible{outline:2px solid var(--color-proof,#b8232a);outline-offset:-2px}"
    },
    {
      "name": "报头版次条 Nav Item",
      "kind": "nav",
      "refersTo": "nav-item-active",
      "description": "报头下五个版次并排，格子之间留 1px 缝露出控件边界灰；当前版次套红实底反白。",
      "html": "<nav class=\"ds-nav\"><a class=\"ds-nav-item ds-nav-item-active\" href=\"#/\">主流程</a><a class=\"ds-nav-item\" href=\"#/plan\">计划卡</a><a class=\"ds-nav-item\" href=\"#/positions\">持仓跟踪</a></nav>",
      "css": ".ds-nav{display:flex;flex-wrap:wrap;align-items:stretch;gap:1px;background:var(--color-rule-strong,#84806f)}.ds-nav-item{display:flex;align-items:center;padding:6px 14px;border-radius:0;background:var(--color-paper,#e4e3de);color:var(--color-ink-soft,#56544c);font-family:var(--font-paper,-apple-system,BlinkMacSystemFont,\"PingFang SC\",sans-serif);font-size:var(--text-body,13px);line-height:var(--text-body--line-height,1.6);text-decoration:none;transition:background-color .1s,color .1s}.ds-nav-item:hover{background:var(--color-slip,#efeee9);color:var(--color-ink,#16161a)}.ds-nav-item-active{background:var(--color-proof,#b8232a);color:var(--color-paper,#e4e3de);font-weight:500}.ds-nav-item:focus-visible{outline:2px solid var(--color-proof,#b8232a);outline-offset:-2px}"
    },
    {
      "name": "结果栏 Stat Grid",
      "kind": "custom",
      "refersTo": "panel",
      "description": "上下 2px 油墨线夹住的一栏读数：标签占固定 8.5rem 窄列，数值从同一条左边缘起排，等宽带 tabular。",
      "html": "<dl class=\"ds-stat-grid\"><div class=\"ds-stat-row\"><dt class=\"ds-stat-label\">可买股数</dt><dd class=\"ds-stat-value\">1000<span class=\"ds-stat-hint\">按一手 100 股向下取整</span></dd></div><div class=\"ds-stat-row\"><dt class=\"ds-stat-label\">止损距离</dt><dd class=\"ds-stat-value\">2.50%</dd></div></dl>",
      "css": ".ds-stat-grid{display:flex;flex-direction:column;margin:0;padding:0 12px;border-top:2px solid var(--color-ink,#16161a);border-bottom:2px solid var(--color-ink,#16161a);background:var(--color-slip,#efeee9);font-family:var(--font-paper,-apple-system,BlinkMacSystemFont,\"PingFang SC\",sans-serif)}.ds-stat-row{display:flex;align-items:baseline;column-gap:12px;padding:6px 0;border-bottom:1px solid var(--color-rule-soft,#c4c1b4)}.ds-stat-row:last-child{border-bottom:0}.ds-stat-label{flex:none;width:8.5rem;font-size:var(--text-note,12px);color:var(--color-ink-soft,#56544c)}.ds-stat-value{min-width:0;flex:1 1 auto;margin:0;font-family:var(--font-mono,\"SF Mono\",ui-monospace,Menlo,monospace);font-size:var(--text-head,16px);line-height:var(--text-head--line-height,1.35);font-weight:500;font-variant-numeric:tabular-nums;color:var(--color-ink,#16161a)}.ds-stat-hint{margin-left:8px;font-family:var(--font-paper,-apple-system,BlinkMacSystemFont,\"PingFang SC\",sans-serif);font-size:var(--text-micro,11px);font-weight:400;color:var(--color-ink-soft,#56544c)}"
    },
    {
      "name": "号外条 Extra Band",
      "kind": "custom",
      "refersTo": "panel",
